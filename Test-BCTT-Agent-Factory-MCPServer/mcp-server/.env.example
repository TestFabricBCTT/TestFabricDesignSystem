# ============================================
# CLAUDE CODE CONFIGURATION
# ============================================
# Uses Claude Code CLI (included in Max plan) instead of Anthropic API.
# No API key needed — Claude Code uses your Max subscription.

# (Optional) Path to Claude Code CLI binary
# Auto-detected from VS Code extensions if not set
# CLAUDE_CLI_PATH=C:\Users\YourUser\.vscode\extensions\anthropic.claude-code-xxx\resources\native-binary\claude.exe

# (Optional) Model to use (default: sonnet)
# Options: haiku, sonnet, opus
# CLAUDE_MODEL=sonnet

# (DEPRECATED) Anthropic API Key — no longer needed with Claude Code integration
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# API Server Port (default: 3001)
API_PORT=3001

# ============================================
# JIRA CLOUD CONFIGURATION
# ============================================

# URL base do Jira Cloud (sem trailing slash)
JIRA_BASE_URL=https://your-domain.atlassian.net

# Email associado à conta Jira
JIRA_USER_EMAIL=your-email@domain.com

# API Token do Jira
# Gerar em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Project Key do Jira (ex: BCTT, DEV, PROJ)
JIRA_PROJECT_KEY=BCTT

# ============================================
# FIGMA CONFIGURATION (DA Agent)
# ============================================

# Figma Personal Access Token
# Gerar em: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=figd_xxxxx

# Figma File Key (AI Tests project)
# Extraído do URL: figma.com/file/{FILE_KEY}/...
FIGMA_FILE_KEY=iYTDVqOqX2DpMkZCHZq8px

# ============================================
# AZURE DEVOPS (OPTIONAL)
# ============================================

# Azure DevOps Personal Access Token
# AZURE_DEVOPS_TOKEN=your-pat-here

# Azure DevOps Organization URL
# AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
