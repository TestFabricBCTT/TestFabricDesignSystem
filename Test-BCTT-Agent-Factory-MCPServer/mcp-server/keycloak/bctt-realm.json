{
  "id": "bctt",
  "realm": "bctt",
  "displayName": "BCTT - Banco Comercial de Testes e Tecnologia",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "passwordPolicy": "length(8)",
  "defaultRoles": ["consultation"],
  "roles": {
    "realm": [
      {
        "name": "consultation",
        "description": "Acesso de consulta — visualizar saldos, movimentos, extractos"
      },
      {
        "name": "operations",
        "description": "Acesso operacional — transferências, pagamentos, gestão de cartões"
      },
      {
        "name": "administration",
        "description": "Acesso administrativo — gestão de perfil, limites, beneficiários"
      },
      {
        "name": "backoffice-admin",
        "description": "Administrador do backoffice Core — gestão de clientes, contas, movimentos"
      }
    ]
  },
  "clients": [
    {
      "clientId": "digital-channels",
      "name": "Digital Channels (Web App)",
      "description": "Frontend app para clientes bancários",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dc-secret-2026-agent-factory",
      "redirectUris": [
        "http://www.DCsCreatedbyAI.pt/*",
        "http://localhost:5173/*",
        "http://fix.DCsCreatedbyAI.pt/*",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://www.DCsCreatedbyAI.pt",
        "http://localhost:5173",
        "http://fix.DCsCreatedbyAI.pt",
        "http://localhost:5174"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "backoffice",
      "name": "Core Backoffice",
      "description": "Admin dashboard para gestão bancária",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bo-secret-2026-agent-factory",
      "redirectUris": [
        "http://backoffice.DCsCreatedbyAI.pt/*",
        "http://localhost:4002/*"
      ],
      "webOrigins": [
        "http://backoffice.DCsCreatedbyAI.pt",
        "http://localhost:4002"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "middleware-api",
      "name": "Middleware API Gateway",
      "description": "Service account para validação JWT no middleware",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mw-secret-2026-agent-factory",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
